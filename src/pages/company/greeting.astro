---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import CTASection from "@/components/CTASection.astro";
import { companySubpages } from "@/data/subpages";
---

<BaseLayout title="대표 인사말" description="비오랩의 대표 메시지와 사업 철학을 소개합니다.">
  <SubHero title="대표 인사말" description="가장 믿을 수 있는 헬스케어 파트너가 되겠습니다." compact />
  <SectionTabs items={companySubpages} label="회사소개 하위 메뉴" />
  <Breadcrumb parent={{ label: "회사소개", href: "/company/" }} current="대표 인사말" />

  <section class="section-band bg-white">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[0.72fr_1.28fr]">
        <aside class="lg:pt-1" data-reveal>
          <div class="inline-flex bg-brand-blue px-8 py-5 text-lg font-black leading-tight text-white">
            회사소개<br />
            <span class="text-base">(Company Overview)</span>
          </div>
          <blockquote class="mt-8 border-l-4 border-brand-green pl-5 text-2xl font-black leading-snug text-slate-950">
            “비오랩 재팬은 가장 믿을 수 있는<br class="hidden sm:block" />
            헬스케어 파트너입니다.”
          </blockquote>
        </aside>

        <div class="text-slate-800" data-reveal>
          <p class="mb-5 text-sm font-black tracking-[0.26em] text-brand-green">CEO MESSAGE</p>
          <h2 class="text-3xl font-black leading-tight text-slate-950 md:text-4xl">대표이사 인사말</h2>

          <div class="mt-8 space-y-6 text-base leading-8">
            <p>
              비오랩 재팬을 방문해 주셔서 감사합니다.
            </p>
            <p>
              비오랩 재팬은 한국에 본사를 두고 있는 (주)비오랩의 일본 현지법인입니다. (주)비오랩은 2015년 창립 이래 인류의 건강한 행복을 위해 마이크로바이옴 분야의 건강기능식품 헬스케어 전문 기업으로서 끊임없는 혁신과 노력을 통해 지속적인 성장을 해오고 있는 전문기업입니다.
            </p>
            <p>
              현재 가장 어렵고 진입 장벽이 높은 일본 시장에서 당사의 iHEAL 브랜드는 전문 프로바이오틱스 영역에서 빛나는 성장을 거듭하고 있으며, 현재 다양한 기능성 건강식품 시장으로의 영역을 구축하고 있습니다. 비오랩 재팬이 공급하는 모든 기능성 소재는 인체적용시험과 SCI 국제학술논문, 관련 특허를 기반으로 검토한 소재입니다.
            </p>
            <p>
              아울러 한국의 선진 제조기업들과의 완벽한 협업과 GMP 제조 시스템으로 생산되는 제품들을 공급하고 있습니다. 우리는 이제 그동안 쌓아 올린 노하우와 경험을 토대로 하여 일본 고객들의 Needs에 부합하는 당사만의 Total Healthcare Solution을 기반으로 하는 다양한 기능성 식품 소재 전문기업으로서 고객들의 든든한 파트너가 되겠습니다.
            </p>
          </div>

          <div class="mt-10 text-right text-lg font-semibold text-slate-900">
            비오랩 대표이사 박종민 드림
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
