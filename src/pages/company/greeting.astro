---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import CTASection from "@/components/CTASection.astro";
import { companySubpages } from "@/data/subpages";
import { withBase } from "@/lib/path";
---

<BaseLayout title="대표 인사말" description="비오랩의 대표 메시지와 사업 철학을 소개합니다.">
  <SubHero title="대표 인사말" description="가장 믿을 수 있는 헬스케어 파트너가 되겠습니다." compact />
  <SectionTabs items={companySubpages} label="회사소개 하위 메뉴" />
  <Breadcrumb parent={{ label: "회사소개", href: "/company/" }} current="대표 인사말" />

  <section class="section-band bg-white">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <figure class="relative mx-auto w-full max-w-[520px] pb-6 pl-6">
          <div class="absolute bottom-0 left-0 h-[72%] w-[82%] bg-brand-green" aria-hidden="true"></div>
          <img
            class="relative aspect-[4/3] w-full border border-slate-200 object-cover shadow-sm"
            src={withBase("/images/ingredients/ingredient-research-lab.jpg")}
            alt="비오랩 원료 연구 이미지"
          />
        </figure>

        <div class="text-slate-700">
          <p class="mb-5 text-sm font-black tracking-[0.26em] text-brand-green">CEO MESSAGE</p>
          <h2 class="text-3xl font-black leading-tight text-brand-navy md:text-4xl">
            반갑습니다.<br />
            비오랩을 찾아주신 모든 분들께 진심으로 감사드립니다.
          </h2>

          <div class="mt-8 space-y-5 text-base leading-8">
            <p>
              비오랩은 인류의 건강한 행복을 위해 기능성 소재와 건강기능식품 분야에서 지속적인 혁신과 성장을 이어가는 헬스케어 기업입니다.
            </p>
            <p>
              iHEAL 브랜드 운영 경험과 마이크로바이옴 프로바이오틱스 소재 역량을 바탕으로, 기능성 소재 공급과 제품화 서비스를 함께 제안합니다.
            </p>
            <p>
              비오랩이 공급하고 검토하는 기능성 소재는 인체적용시험, 논문, 특허 등 근거 자료를 중심으로 살펴보고, 공개 커뮤니케이션에서는 관련 기준을 준수하는 것을 원칙으로 합니다.
            </p>
            <p>
              앞으로도 비오랩은 소재, 제조, 브랜드, 유통을 연결하는 토털 헬스케어 파트너로서 고객과 파트너의 니즈에 맞는 실질적인 사업 기회를 만들어가겠습니다.
            </p>
          </div>

          <div class="mt-10 text-right text-lg font-semibold text-slate-900">
            비오랩 대표이사 박종민 드림
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
