---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import CTASection from "@/components/CTASection.astro";
import { companySubpages } from "@/data/subpages";
---

<BaseLayout title="비전 및 목표" description="비오랩의 비전과 기능성 헬스케어 사업 목표를 소개합니다.">
  <SubHero title="비전 및 목표" description="기능성 헬스케어 시장에서 신뢰받는 사업 파트너를 지향합니다." compact />
  <SectionTabs items={companySubpages} label="회사소개 하위 메뉴" />
  <Breadcrumb parent={{ label: "회사소개", href: "/company/" }} current="비전 및 목표" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="VISION & MISSION" title="Beyond Functional Healthcare Solutions" description="비오랩은 기능성 소재, 제품화, 브랜드 운영을 연결해 건강기능식품 사업의 신뢰도 높은 파트너가 되는 것을 목표로 합니다." />
      <div class="grid gap-6 lg:grid-cols-3" data-reveal-group>
        {[
          ["Vision", "기능성 헬스케어 솔루션을 넘어, 시장과 고객이 신뢰할 수 있는 사업 기준을 만듭니다."],
          ["Mission", "소재 공급, OEM/ODM, 브랜드 운영 경험을 연결해 파트너의 제품화 가능성을 높입니다."],
          ["Goal", "국내 비오랩과 BIOLAB Japan의 네트워크를 활용해 한국과 일본 시장을 잇는 헬스케어 사업 기반을 확장합니다."]
        ].map(([title, body]) => (
          <article class="border border-slate-200 bg-white p-8 shadow-sm" data-reveal>
            <span class="text-sm font-black tracking-[0.22em] text-brand-green">{title}</span>
            <p class="mt-5 text-lg font-bold leading-8 text-brand-navy">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
