---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import SubpageGrid from "@/components/SubpageGrid.astro";
import CTASection from "@/components/CTASection.astro";
import { companySubpages } from "@/data/subpages";
import { withBase } from "@/lib/path";
---

<BaseLayout title="회사소개" description="비오랩의 대표 인사말, 비전 및 목표를 소개합니다.">
  <SubHero title="회사소개" description="기능성 소재와 제품 사업을 연결하며 건강한 일상의 파트너가 되겠습니다." />
  <Breadcrumb current="회사소개" />

  <section class="section-band bg-white">
    <div class="container-page space-y-20">
      <div class="grid gap-12 lg:grid-cols-[0.52fr_0.48fr] lg:items-center" data-reveal-group>
        <figure class="relative overflow-hidden bg-brand-navy" data-reveal="image">
          <img
            class="aspect-[4/3] h-full w-full scale-110 object-cover object-[58%_44%] opacity-90 saturate-[0.92]"
            src={withBase("/images/science/petri-pipette-lab.jpg")}
            alt="유산균 연구와 제품 설계를 상징하는 원료 이미지"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(23,50,77,0.42),rgba(88,182,166,0.18))]"></div>
        </figure>

        <div data-reveal>
          <p class="mb-5 text-sm font-black tracking-[0.28em] text-brand-green">COMPANY VISION</p>
          <h2 class="text-4xl font-light leading-tight text-brand-ink md:text-5xl">
            믿을 수 있는<br />
            헬스케어 사업 파트너
          </h2>
          <p class="mt-8 text-base leading-8 text-slate-700">
            비오랩은 기능성 소재 검토, 제품 기획, 제조 네트워크, 브랜드 운영 경험을 바탕으로 건강기능식품 사업을 전개합니다.
            마이크로바이옴 프로바이오틱스와 자연유래 기능성 소재를 중심으로 고객과 파트너에게 필요한 헬스케어 솔루션을 제안합니다.
          </p>
          <ul class="mt-8 space-y-3 text-sm font-semibold leading-7 text-slate-700">
            <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 shrink-0 bg-brand-green"></span>기능성 소재 공급과 제품화 검토</li>
            <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 shrink-0 bg-brand-green"></span>OEM/ODM 제조 네트워크 연계</li>
            <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 shrink-0 bg-brand-green"></span>iHEAL 브랜드 운영과 국내외 채널 커뮤니케이션</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-band bg-slate-50">
    <div class="container-page">
      <SectionTitle
        eyebrow="ABOUT BIOLAB"
        title="회사소개 세부 메뉴"
        description="대표이사 인사말과 비오랩의 비전 및 목표를 확인할 수 있습니다."
      />
      <SubpageGrid items={companySubpages} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
