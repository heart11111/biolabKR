---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import CTASection from "@/components/CTASection.astro";
import { businessSubpages } from "@/data/subpages";
import { site } from "@/data/site";
---

<BaseLayout title="브랜드 매니지먼트" description="iHEAL 브랜드 운영과 파트너 커뮤니케이션 서비스를 소개합니다.">
  <SubHero title="브랜드 매니지먼트" description="브랜드 자료, 유통 채널, 고객 접점을 일관된 기준으로 관리합니다." compact />
  <SectionTabs items={businessSubpages} label="사업/서비스 하위 메뉴" />
  <Breadcrumb parent={{ label: "사업/서비스", href: "/business/" }} current="브랜드 매니지먼트" />

  <section class="section-band bg-white">
    <div class="container-page grid gap-10 lg:grid-cols-[0.42fr_0.58fr] lg:items-start">
      <div>
        <SectionTitle align="left" eyebrow="BRAND MANAGEMENT" title="iHEAL 운영 경험을 사업 자료로 연결합니다" description="국내외 유통 채널에서 축적한 제품 정보, 고객 반응, 파트너 커뮤니케이션 경험을 제품화 과정에 반영합니다." />
        <a class="inline-flex border border-brand-blue px-5 py-3 text-sm font-bold text-brand-blue" href={site.japanUrl} target="_blank" rel="noreferrer">BIOLAB Japan 보기</a>
      </div>
      <div class="grid gap-5" data-reveal-group>
        {[
          ["제품 자료 관리", "성분, 섭취 기준, 품질 정보, 채널별 소개 문구를 일관되게 정리합니다."],
          ["채널 커뮤니케이션", "국내외 유통 파트너가 제품을 이해할 수 있도록 필요한 정보를 구조화합니다."],
          ["브랜드 협업 검토", "iHEAL 브랜드 활용, 공동 상품화, 로열티형 협업 가능성을 검토합니다."]
        ].map(([title, body]) => (
          <article class="border border-slate-200 bg-white p-7 shadow-sm" data-reveal>
            <h2 class="text-2xl font-black text-brand-navy">{title}</h2>
            <p class="mt-4 text-sm leading-7 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
