---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import CTASection from "@/components/CTASection.astro";
import { businessSubpages } from "@/data/subpages";
import { natureSupplyItems, probioticSupplyItems } from "@/data/supply";
import { withBase } from "@/lib/path";
---

<BaseLayout title="기능성 소재 공급" description="프로바이오틱스와 자연유래 기능성 소재 공급 서비스를 소개합니다.">
  <SubHero title="기능성 소재 공급" description="제품 목적에 맞는 기능성 소재와 근거 자료를 함께 검토합니다." compact />
  <SectionTabs items={businessSubpages} label="사업/서비스 하위 메뉴" />
  <Breadcrumb parent={{ label: "사업/서비스", href: "/business/" }} current="기능성 소재 공급" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="INGREDIENT SUPPLY" title="마이크로바이옴과 자연유래 소재를 함께 제안합니다" description="B2B 제품 기획 단계에서 필요한 적용 영역, 섭취 기준, 근거 자료, 제조 가능성을 통합적으로 검토합니다." />
      <div class="grid gap-8 lg:grid-cols-2">
        <article class="border border-slate-200 bg-white p-8 shadow-sm" data-reveal>
          <h2 class="text-2xl font-black text-brand-navy">Microbiome Probiotics</h2>
          <p class="mt-4 text-sm leading-7 text-slate-600">여성, 체지방, 인지, 간, 코, 스트레스, 장 건강 컨셉의 프로바이오틱스 소재를 정리합니다.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {probioticSupplyItems.map((item) => <span class="bg-brand-mint px-3 py-2 text-xs font-bold text-brand-green">{item.area}</span>)}
          </div>
          <a class="mt-7 inline-flex text-sm font-extrabold text-brand-blue" href={withBase("/products/microbiome-probiotics/")}>소재 리스트 보기 →</a>
        </article>
        <article class="border border-slate-200 bg-white p-8 shadow-sm" data-reveal>
          <h2 class="text-2xl font-black text-brand-navy">Functional Nature's Food Ingredients</h2>
          <p class="mt-4 text-sm leading-7 text-slate-600">남성 건강, 기억, 인지, 체지방, 피부, 간, 면역 기능 컨셉의 자연유래 소재를 검토합니다.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {natureSupplyItems.map((item) => <span class="bg-slate-50 px-3 py-2 text-xs font-bold text-slate-700">{item.area}</span>)}
          </div>
          <a class="mt-7 inline-flex text-sm font-extrabold text-brand-blue" href={withBase("/products/nature-ingredients/")}>소재 리스트 보기 →</a>
        </article>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
