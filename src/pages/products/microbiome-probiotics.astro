---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import CTASection from "@/components/CTASection.astro";
import { productMenuSubpages } from "@/data/subpages";
import { probioticSupplyItems } from "@/data/supply";
import { withBase } from "@/lib/path";
---

<BaseLayout title="Microbiome Probiotics" description="용도별 프로바이오틱스 공급 소재를 소개합니다.">
  <SubHero title="Microbiome Probiotics" description="여성, 체지방, 인지, 간, 코, 스트레스, 장 건강 컨셉의 프로바이오틱스 소재입니다." compact />
  <SectionTabs items={productMenuSubpages} label="공급제품 하위 메뉴" />
  <Breadcrumb parent={{ label: "공급제품", href: "/products/" }} current="Microbiome Probiotics" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="PROBIOTICS LIST" title="Microbiome Probiotics 전체 리스트" description="품목별 적용 영역, 기준 섭취량, 원료명, 근거 자료를 공개 사이트용 완화 표현으로 정리했습니다." />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {probioticSupplyItems.map((item) => (
          <article class="flex h-full flex-col overflow-hidden border border-slate-200 bg-white shadow-sm" data-reveal>
            <img class="aspect-[4/3] w-full object-cover" src={withBase(item.image)} alt="" loading="lazy" decoding="async" />
            <div class="flex flex-1 flex-col p-6">
              <span class="text-xs font-black tracking-[0.2em] text-brand-green">{item.area}</span>
              <h2 class="mt-4 text-xl font-black leading-tight text-brand-navy">{item.name}</h2>
              <p class="mt-2 text-sm font-semibold text-slate-500">{item.englishName}</p>
              <p class="mt-4 flex-1 text-sm leading-7 text-slate-600">{item.summary}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {item.evidence.map((tag) => <span class="bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
