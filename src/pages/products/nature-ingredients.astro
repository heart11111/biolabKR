---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import CTASection from "@/components/CTASection.astro";
import { productMenuSubpages } from "@/data/subpages";
import { natureSupplyItems } from "@/data/supply";
import { withBase } from "@/lib/path";
---

<BaseLayout title="Functional Nature's Food Ingredients" description="자연유래 기능성 소재 공급 제품을 소개합니다.">
  <SubHero title="Functional Nature's Food Ingredients" description="남성 건강, 기억, 인지, 체지방, 피부, 간, 면역 컨셉의 자연유래 소재입니다." compact />
  <SectionTabs items={productMenuSubpages} label="공급제품 하위 메뉴" />
  <Breadcrumb parent={{ label: "공급제품", href: "/products/" }} current="Functional Nature's Food Ingredients" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="NATURE LIST" title="Functional Nature's Food Ingredients 전체 리스트" description="자연유래 기능성 소재를 적용 영역과 제품 기획 관점으로 정리했습니다." />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {natureSupplyItems.map((item) => (
          <article class="flex h-full flex-col overflow-hidden border border-slate-200 bg-white shadow-sm" data-reveal>
            <img class="aspect-[4/3] w-full object-cover" src={withBase(item.image)} alt="" loading="lazy" decoding="async" />
            <div class="flex flex-1 flex-col p-6">
              <span class="text-xs font-black tracking-[0.2em] text-brand-green">{item.area}</span>
              <h2 class="mt-4 text-xl font-black leading-tight text-brand-navy">{item.name}</h2>
              <p class="mt-2 text-sm font-semibold text-slate-500">{item.englishName}</p>
              <p class="mt-4 flex-1 text-sm leading-7 text-slate-600">{item.summary}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {item.evidence.map((tag) => <span class="bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
