---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CTASection from "@/components/CTASection.astro";
import { products, type Product } from "@/data/products";
import { site } from "@/data/site";
import { withBase } from "@/lib/path";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

type Props = {
  product: Product;
};

const { product } = Astro.props;
const productUrl = new URL(`/products/${product.slug}/`, site.url).toString();
const productStructuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${productUrl}#product`,
  name: product.name,
  alternateName: product.englishName,
  description: product.summary,
  category: product.category,
  image: new URL(withBase(product.image), site.url).toString(),
  url: productUrl,
  brand: {
    "@type": "Brand",
    name: site.brandName
  },
  manufacturer: {
    "@id": `${site.url}#organization`
  }
};
---

<BaseLayout title={product.name} description={product.summary} image={product.image} structuredData={productStructuredData}>
  <SubHero title={product.name} description={product.tagline} image="/images/science/clinical-capsules-doctor.jpg" imagePosition="55% 48%" visualWord="iHEAL" />
  <Breadcrumb parent={{ label: "제품소개", href: "/products/" }} current={product.name} />

  <section class="bg-white pb-20 pt-10 lg:pb-24">
    <div class="container-page">
      <nav class="mb-12 grid overflow-hidden border border-slate-200 bg-white text-center text-sm font-extrabold text-slate-700 md:grid-cols-3 lg:grid-cols-6" aria-label="제품 상세 메뉴">
        {products.map((item) => (
          <a
            class:list={[
              "border-b border-slate-200 px-4 py-4 transition hover:bg-brand-mint hover:text-brand-green md:border-r lg:border-b-0",
              item.slug === product.slug ? "bg-brand-green text-white hover:bg-brand-green hover:text-white" : "bg-white",
              item.slug === products[products.length - 1].slug ? "md:border-r-0" : ""
            ]}
            href={withBase(`/products/${item.slug}/`)}
          >
            {item.name.replace("아이힐 ", "")}
          </a>
        ))}
      </nav>
    </div>

    <div class="mx-auto w-full max-w-[860px] bg-white px-4 sm:px-0">
      {product.detailImages.map((src, index) => (
        <img
          class="block w-full"
          src={withBase(src)}
          alt={`${product.name} 상세페이지 ${index + 1}`}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      ))}
    </div>

    <div class="container-page mt-12 flex flex-wrap justify-center gap-4">
      <a class="inline-flex bg-brand-green px-7 py-4 text-sm font-extrabold text-white transition hover:bg-brand-navy" href={site.shopUrl} target="_blank" rel="noreferrer">
        iHEAL Mall 바로가기
      </a>
      <a class="inline-flex border border-brand-green px-7 py-4 text-sm font-extrabold text-brand-green transition hover:bg-brand-mint" href={withBase("/support/contact/")}>
        제품 문의하기
      </a>
    </div>
  </section>

  <CTASection />
</BaseLayout>
