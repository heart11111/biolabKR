---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import SubpageGrid from "@/components/SubpageGrid.astro";
import ProductCard from "@/components/ProductCard.astro";
import CTASection from "@/components/CTASection.astro";
import { productSubpages } from "@/data/subpages";
import { products } from "@/data/products";
import { site } from "@/data/site";
---

<BaseLayout title="iHEAL 제품" description="비오랩 산하 iHEAL 브랜드의 주요 제품을 소개합니다.">
  <SubHero title="iHEAL 제품" description="여성 건강, 키즈 건강, 다이어트, 이너케어 제품군을 한곳에서 확인할 수 있습니다." />
  <Breadcrumb current="iHEAL 제품" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="iHEAL BRAND PRODUCTS" title="아이힐 제품군" description="아이힐몰 기준 주요 제품군을 보기 쉽게 정리했습니다." />
      <SubpageGrid items={productSubpages} />
    </div>
  </section>

  <section class="section-band bg-slate-50">
    <div class="container-page">
      <SectionTitle eyebrow="PRODUCT LINEUP" title="주요 제품" description="제품 상세 페이지에서는 특징과 사용 정보를 간단히 확인할 수 있습니다." />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {products.map((product) => <ProductCard product={product} />)}
      </div>
      <div class="mt-10 text-center">
        <a class="inline-flex bg-brand-green px-7 py-4 text-sm font-extrabold text-white transition hover:bg-brand-navy" href={site.shopUrl} target="_blank" rel="noreferrer">
          iHEAL Mall 바로가기
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
