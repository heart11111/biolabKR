---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import SubpageGrid from "@/components/SubpageGrid.astro";
import ProductCard from "@/components/ProductCard.astro";
import CTASection from "@/components/CTASection.astro";
import { productSubpages } from "@/data/subpages";
import { products } from "@/data/products";
import { withBase } from "@/lib/path";
---

<BaseLayout title="공급제품" description="비오랩의 프로바이오틱스와 자연유래 기능성 소재 공급 제품을 소개합니다.">
  <SubHero title="공급제품" description="마이크로바이옴 프로바이오틱스와 자연유래 기능성 소재 포트폴리오를 공급 관점에서 소개합니다." />
  <Breadcrumb current="공급제품" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="SUPPLY PRODUCT" title="공급제품 카테고리" description="PPT 사이트맵 기준에 맞춰 프로바이오틱스와 자연유래 기능성 소재를 구분했습니다." />
      <SubpageGrid items={productSubpages} />
    </div>
  </section>

  <section class="section-band bg-slate-50">
    <div class="container-page">
      <SectionTitle eyebrow="iHEAL BRAND PRODUCTS" title="운영 중인 iHEAL 제품" description="현재 판매·운영 중인 iHEAL 제품군은 브랜드 제품 참고 자료로 함께 유지합니다." />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="section-band bg-white">
    <div class="container-page grid gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:items-center">
      <SectionTitle
        align="left"
        eyebrow="E-CATALOG"
        title="카탈로그형 공급 정보"
        description="소재 리스트, 적용 영역, 근거 자료, 상담 흐름을 카탈로그 방식으로 확인할 수 있습니다."
      />
      <div class="grid gap-4 md:grid-cols-3" data-reveal-group>
        <a class="border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-green" href={withBase("/products/catalog/")} data-reveal>
          <strong class="text-lg font-black text-brand-navy">E-Catalog</strong>
          <p class="mt-3 text-sm leading-6 text-slate-600">공급 가능 소재와 상담 준비 사항을 확인합니다.</p>
        </a>
        <a class="border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-green" href={withBase("/support/contact/")} data-reveal>
          <strong class="text-lg font-black text-brand-navy">Customer Inquiries</strong>
          <p class="mt-3 text-sm leading-6 text-slate-600">제품화, 유통, 브랜드 협업 문의를 접수합니다.</p>
        </a>
        <a class="border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-green" href={withBase("/business/")} data-reveal>
          <strong class="text-lg font-black text-brand-navy">Business Service</strong>
          <p class="mt-3 text-sm leading-6 text-slate-600">소재 공급과 OEM/ODM 흐름을 함께 확인합니다.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
