---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import SubpageGrid from "@/components/SubpageGrid.astro";
import ProductCard from "@/components/ProductCard.astro";
import CTASection from "@/components/CTASection.astro";
import { productSubpages } from "@/data/subpages";
import { products } from "@/data/products";
import { site } from "@/data/site";

const productShowcase = [
  {
    name: "아이힐 비너스",
    subtitle: "여성을 위한 질 유래 특허 유산균",
    image: "/images/products/card-venus-probiotics.jpg",
    summary:
      "아이힐 비너스 유산균은 건강한 한국 여성의 질에서 유래한 특허 유산균 3종을 중심으로 설계한 iHEAL 대표 여성 유산균입니다. 데일리 여성 건강 루틴과 섭취 편의성을 함께 고려했습니다.",
    features: [
      "여성 질 내 유래 특허 균주 MG242, MG901, MG989 적용",
      "철분, 크랜베리 등 여성 건강 루틴을 고려한 배합",
      "하루 1캡슐로 관리하기 쉬운 30일 구성"
    ],
    specs: [
      ["원산국", "대한민국"],
      ["내용량", "500mg x 30캡슐"],
      ["제품유형", "건강기능식품"]
    ],
    highlights: [
      ["20억", "보장 유산균"],
      ["3종", "특허 유산균"],
      ["30일분", "캡슐 구성"]
    ],
    ingredients: "L. salivarius MG242, L. fermentum MG901, L. plantarum MG989, 철분, 크랜베리 등",
    badges: ["여성 유산균", "대표 제품", "하루 1캡슐"]
  },
  {
    name: "아이힐 라인엔",
    subtitle: "가르시니아와 특허 유산균을 담은 다이어트 유산균",
    image: "/images/products/card-line-n-probiotics.jpg",
    summary:
      "아이힐 라인엔 유산균은 체지방 관리 컨셉의 특허 유산균과 가르시니아 캄보지아 추출물을 함께 담은 스틱형 제품입니다. 바쁜 일상에서도 간편하게 이어갈 수 있는 다이어트 루틴을 제안합니다.",
    features: [
      "항비만 컨셉 특허 균주 MG4231, MG4244 적용",
      "가르시니아 캄보지아 추출물과 HCA 배합",
      "휴대와 섭취가 쉬운 30포 스틱 구성"
    ],
    specs: [
      ["원산국", "대한민국"],
      ["내용량", "750mg x 30포"],
      ["제품유형", "건강기능식품"]
    ],
    highlights: [
      ["20억", "보장 유산균"],
      ["2종", "특허 균주"],
      ["30일분", "스틱 구성"]
    ],
    ingredients: "L. fermentum MG4231, L. fermentum MG4244, 가르시니아 캄보지아 추출물, 셀레늄 등",
    badges: ["다이어트", "스틱형", "하루 1포"]
  },
  {
    name: "아이힐 메디바이옴",
    subtitle: "데일리 이너케어를 위한 약산성 페미닌 워시",
    image: "/images/products/card-inner-clean-v.jpg",
    summary:
      "아이힐 메디바이옴 이너클린 V는 민감한 부위의 데일리 세정을 고려한 약산성 클렌저입니다. 락토바실러스 발효여과물과 식물 유래 성분을 바탕으로 부드러운 사용감을 설계했습니다.",
    features: [
      "민감 부위 데일리 세정을 고려한 약산성 포뮬러",
      "락토바실러스 발효여과물과 13종 발효 약재 추출물 배합",
      "부드러운 거품 타입의 150ml 클렌저"
    ],
    specs: [
      ["원산국", "대한민국"],
      ["내용량", "150ml"],
      ["제품유형", "페미닌 워시"]
    ],
    highlights: [
      ["약산성", "데일리 케어"],
      ["13종", "발효 성분"],
      ["150ml", "폼 타입"]
    ],
    ingredients: "락토바실러스 발효여과물, 13종 발효 약재 추출물, 데실글루코사이드, 시트릭애씨드 등",
    badges: ["이너케어", "저자극 컨셉", "외용 제품"]
  }
];
---

<BaseLayout title="iHEAL 제품" description="비오랩 산하 iHEAL 브랜드의 주요 제품을 소개합니다.">
  <SubHero title="iHEAL 제품" description="여성 건강, 키즈 건강, 다이어트, 이너케어 제품군을 한곳에서 확인할 수 있습니다." />
  <Breadcrumb current="iHEAL 제품" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="iHEAL BRAND PRODUCTS" title="아이힐 제품군" description="아이힐몰 기준 주요 제품군을 보기 쉽게 정리했습니다." />
      <SubpageGrid items={productSubpages} />
    </div>
  </section>

  <section class="bg-white pb-20 pt-4 lg:pb-24">
    <div class="container-page">
      <div class="mb-14">
        <p class="mb-4 text-sm font-black tracking-[0.2em] text-brand-blue">PRODUCT DETAILS</p>
        <h2 class="text-4xl font-black leading-tight text-brand-navy md:text-5xl">대표 제품 상세</h2>
        <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
          아이힐 브랜드의 주요 제품을 이미지, 제품 특징, 구성 정보 중심으로 정리했습니다.
        </p>
      </div>

      <div class="grid gap-16 lg:gap-20">
        {productShowcase.map((product) => (
          <article class="grid gap-8 border-t border-slate-200 pt-10 lg:grid-cols-[420px_minmax(0,1fr)] lg:gap-14 lg:pt-12">
            <div>
              <p class="mb-3 text-sm font-bold text-slate-600">{product.subtitle}</p>
              <h3 class="mb-6 text-3xl font-black text-brand-navy md:text-4xl">{product.name}</h3>
              <img class="aspect-[4/3] w-full rounded-lg border border-slate-200 bg-slate-50 object-contain shadow-sm" src={product.image} alt={`${product.name} 제품 이미지`} loading="lazy" decoding="async" />
              <dl class="mt-4 grid overflow-hidden rounded-lg border border-slate-200 bg-white text-center sm:grid-cols-3">
                {product.specs.map(([label, value]) => (
                  <div class="border-b border-slate-200 p-4 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0">
                    <dt class="text-xs font-bold text-slate-500">{label}</dt>
                    <dd class="mt-2 text-sm font-black text-brand-navy">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="pt-2">
              <p class="text-base leading-8 text-slate-700">{product.summary}</p>

              <section class="mt-8">
                <h4 class="mb-4 flex items-center gap-3 text-sm font-black tracking-[0.12em] text-brand-blue">
                  <span class="h-0.5 w-8 bg-brand-blue"></span>
                  특징
                </h4>
                <ul class="grid gap-3">
                  {product.features.map((feature) => (
                    <li class="flex gap-3 text-sm leading-7 text-slate-700">
                      <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-green"></span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </section>

              <section class="mt-8">
                <h4 class="mb-4 flex items-center gap-3 text-sm font-black tracking-[0.12em] text-brand-blue">
                  <span class="h-0.5 w-8 bg-brand-blue"></span>
                  성분 및 스펙
                </h4>
                <div class="grid gap-3 sm:grid-cols-3">
                  {product.highlights.map(([value, label]) => (
                    <div class="rounded-lg border border-slate-200 bg-white p-4 text-center shadow-sm">
                      <strong class="block text-2xl font-black text-brand-green">{value}</strong>
                      <span class="mt-2 block text-xs font-bold text-slate-500">{label}</span>
                    </div>
                  ))}
                </div>
                <p class="mt-4 text-sm leading-7 text-slate-600">{product.ingredients}</p>
              </section>

              <section class="mt-8">
                <h4 class="mb-4 flex items-center gap-3 text-sm font-black tracking-[0.12em] text-brand-blue">
                  <span class="h-0.5 w-8 bg-brand-blue"></span>
                  분류
                </h4>
                <div class="flex flex-wrap gap-2">
                  {product.badges.map((badge) => (
                    <span class="rounded-full border border-slate-200 px-4 py-2 text-xs font-black text-slate-600">{badge}</span>
                  ))}
                </div>
              </section>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band bg-slate-50">
    <div class="container-page">
      <SectionTitle eyebrow="PRODUCT LINEUP" title="주요 제품" description="제품 상세 페이지에서는 특징과 사용 정보를 간단히 확인할 수 있습니다." />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {products.map((product) => <ProductCard product={product} />)}
      </div>
      <div class="mt-10 text-center">
        <a class="inline-flex bg-brand-green px-7 py-4 text-sm font-extrabold text-white transition hover:bg-brand-navy" href={site.shopUrl} target="_blank" rel="noreferrer">
          iHEAL Mall 바로가기
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
