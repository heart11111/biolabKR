---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import CTASection from "@/components/CTASection.astro";
import { productMenuSubpages } from "@/data/subpages";
import { natureSupplyItems, probioticSupplyItems } from "@/data/supply";
import { withBase } from "@/lib/path";
---

<BaseLayout title="E-Catalog" description="비오랩 공급 제품 카탈로그 안내입니다.">
  <SubHero title="E-Catalog" description="공급 가능 소재와 상담 준비 정보를 카탈로그 형태로 정리했습니다." compact />
  <SectionTabs items={productMenuSubpages} label="공급제품 하위 메뉴" />
  <Breadcrumb parent={{ label: "공급제품", href: "/products/" }} current="E-Catalog" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="CATALOG" title="공급 검토용 카탈로그" description="상세 자료는 문의 접수 후 제품 목적, 출시 국가, 필요 자료 범위에 맞춰 안내합니다." />
      <div class="grid gap-8 lg:grid-cols-2">
        <article class="border border-slate-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-black text-brand-navy">Microbiome Probiotics</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">총 {probioticSupplyItems.length}개 소재 포트폴리오</p>
          <a class="mt-6 inline-flex bg-brand-green px-5 py-3 text-sm font-bold text-white" href={withBase("/products/microbiome-probiotics/")}>리스트 보기</a>
        </article>
        <article class="border border-slate-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-black text-brand-navy">Functional Nature's Food Ingredients</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">총 {natureSupplyItems.length}개 소재 포트폴리오</p>
          <a class="mt-6 inline-flex bg-brand-green px-5 py-3 text-sm font-bold text-white" href={withBase("/products/nature-ingredients/")}>리스트 보기</a>
        </article>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
