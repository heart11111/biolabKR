---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { supportSubpages } from "@/data/subpages";
import { natureSupplyItems, probioticSupplyItems } from "@/data/supply";
import { withBase } from "@/lib/path";
---

<BaseLayout title="E-Catalog" description="비오랩 공급제품 카탈로그 안내입니다.">
  <SubHero title="E-Catalog" description="공급 가능 소재와 상담 준비 정보를 확인할 수 있습니다." compact />
  <SectionTabs items={supportSubpages} label="문의사항 하위 메뉴" />
  <Breadcrumb parent={{ label: "문의사항", href: "/support/" }} current="E-Catalog" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="E-CATALOG" title="카탈로그 확인 경로" description="상세 자료는 문의 접수 후 제품 목적과 필요한 자료 범위에 맞춰 안내합니다." />
      <div class="grid gap-6 lg:grid-cols-3" data-reveal-group>
        <a class="border border-slate-200 bg-white p-7 shadow-sm transition hover:border-brand-green" href={withBase("/products/microbiome-probiotics/")} data-reveal>
          <strong class="text-xl font-black text-brand-navy">Microbiome Probiotics</strong>
          <p class="mt-3 text-sm leading-7 text-slate-600">{probioticSupplyItems.length}개 프로바이오틱스 소재 리스트</p>
        </a>
        <a class="border border-slate-200 bg-white p-7 shadow-sm transition hover:border-brand-green" href={withBase("/products/nature-ingredients/")} data-reveal>
          <strong class="text-xl font-black text-brand-navy">Functional Nature's Food Ingredients</strong>
          <p class="mt-3 text-sm leading-7 text-slate-600">{natureSupplyItems.length}개 자연유래 기능성 소재 리스트</p>
        </a>
        <a class="border border-slate-200 bg-white p-7 shadow-sm transition hover:border-brand-green" href={withBase("/support/contact/")} data-reveal>
          <strong class="text-xl font-black text-brand-navy">Customer Inquiries</strong>
          <p class="mt-3 text-sm leading-7 text-slate-600">카탈로그 상세 자료 요청 및 상담 접수</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
