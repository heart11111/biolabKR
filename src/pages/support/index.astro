---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import SubpageGrid from "@/components/SubpageGrid.astro";
import { supportSubpages } from "@/data/subpages";
---

<BaseLayout title="고객지원" description="비오랩 공지사항, FAQ, 문의 연락처를 안내합니다.">
  <SubHero title="문의사항" description="카탈로그, 고객 문의, 공식 소통 채널을 안내합니다." />
  <Breadcrumb current="문의사항" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="COMMUNICATION" title="문의사항 안내" description="E-Catalog 확인, 고객 문의 접수, 국내외 공식 채널 이동을 한곳에서 안내합니다." />
      <SubpageGrid items={supportSubpages} />
    </div>
  </section>
</BaseLayout>
