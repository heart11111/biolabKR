---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CTASection from "@/components/CTASection.astro";
import { news, type NewsItem } from "@/data/news";
import { withBase } from "@/lib/path";

export function getStaticPaths() {
  return news.map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

type Props = {
  item: NewsItem;
};

const { item } = Astro.props;
const originalUrl = item.sourceUrl ?? item.imageSourceUrl;
const originalName = item.sourceName ?? "원문 자료";
const originalTitle = item.sourceTitle ?? item.title;
const originalLead = item.sourceLead ?? item.summary;
const originalDate = item.sourcePublishedAt ?? item.date;
const originalUrlForDisplay = originalUrl.startsWith("http") ? originalUrl : new URL(withBase(originalUrl), Astro.site ?? Astro.url).toString();
---

<BaseLayout title={item.title} description={item.summary}>
  <SubHero title="공지사항 / 보도자료" description="비오랩과 iHEAL 브랜드의 주요 소식을 전합니다." visualWord="NEWS" />
  <Breadcrumb parent={{ label: "공지사항 / 보도자료", href: "/support/news/" }} current={item.title} />

  <article class="section-band bg-white">
    <div class="container-page max-w-5xl">
      <div class="border-t-2 border-brand-navy">
        <header class="border-b border-slate-200 bg-white px-5 py-8 md:px-8">
          <div class="mb-4 flex flex-wrap items-center gap-2 text-sm font-bold">
            <span class="bg-brand-mint px-3 py-1 text-brand-green">{item.category}</span>
            <span class="text-slate-500">비오랩 게시판</span>
          </div>
          <h1 class="text-3xl font-black leading-tight text-brand-navy md:text-4xl">{item.title}</h1>
        </header>

        <div class="grid border-b border-slate-200 bg-slate-50 text-sm text-slate-600 md:grid-cols-4">
          <div class="border-b border-slate-200 px-5 py-4 md:border-b-0 md:border-r">
            <strong class="mr-3 text-brand-navy">작성자</strong>{item.author ?? "비오랩"}
          </div>
          <div class="border-b border-slate-200 px-5 py-4 md:border-b-0 md:border-r">
            <strong class="mr-3 text-brand-navy">작성일</strong>{item.date}
          </div>
          <div class="border-b border-slate-200 px-5 py-4 md:border-b-0 md:border-r">
            <strong class="mr-3 text-brand-navy">구분</strong>{item.category}
          </div>
          <div class="px-5 py-4">
            <strong class="mr-3 text-brand-navy">조회수</strong>{item.views ?? "-"}
          </div>
        </div>

        <div class="border-b border-slate-200 px-5 py-10 md:px-8">
          <figure class="mb-10 overflow-hidden border border-slate-200 bg-white" data-reveal="image">
            <a href={withBase(item.imageSourceUrl)} target="_blank" rel="noreferrer" aria-label={`${item.imageCredit} 보기`}>
              <img class="mx-auto max-h-[360px] w-full object-contain p-5 md:p-10" src={withBase(item.image)} alt={item.imageAlt} />
            </a>
            <figcaption class="border-t border-slate-200 px-5 py-3 text-xs leading-6 text-slate-500">
              <a class="font-semibold text-slate-600 underline-offset-4 hover:text-brand-blue hover:underline" href={withBase(item.imageSourceUrl)} target="_blank" rel="noreferrer">
                {item.imageCredit}
              </a>
            </figcaption>
          </figure>

          <section class="mb-10 border border-brand-blue/25 bg-sky-50 p-5 md:p-7" aria-labelledby="original-article-title">
            <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
              <div class="max-w-3xl">
                <p class="text-xs font-black uppercase tracking-[0.24em] text-brand-blue">Original Article</p>
                <h2 id="original-article-title" class="mt-3 text-2xl font-black leading-snug text-brand-navy md:text-3xl">
                  {originalTitle}
                </h2>
                <dl class="mt-4 grid gap-2 text-sm font-bold text-slate-600 sm:grid-cols-2">
                  <div>
                    <dt class="sr-only">출처</dt>
                    <dd>출처: {originalName}</dd>
                  </div>
                  <div>
                    <dt class="sr-only">게시일</dt>
                    <dd>게시일: {originalDate}</dd>
                  </div>
                </dl>
                <p class="mt-4 text-base leading-8 text-slate-700">{originalLead}</p>
                <p class="mt-3 break-all text-sm text-slate-500">{originalUrlForDisplay}</p>
              </div>
              <a class="inline-flex w-fit shrink-0 bg-brand-blue px-5 py-3 text-sm font-black text-white underline-offset-4 hover:bg-brand-navy hover:underline" href={withBase(originalUrl)} target="_blank" rel="noreferrer">
                기사 원문 보기
              </a>
            </div>
          </section>

          <section class="space-y-6 border-t border-slate-200 pt-8 text-base leading-8 text-slate-700" aria-labelledby="biolab-note-title">
            <h2 id="biolab-note-title" class="text-xl font-black text-brand-navy">비오랩 참고 메모</h2>
            {item.body.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        </div>

        <div class="flex justify-end border-b border-slate-200 bg-white px-5 py-6 md:px-8">
          <a class="border border-brand-navy px-6 py-3 text-sm font-bold text-brand-navy hover:bg-brand-navy hover:text-white" href={withBase("/support/news/")}>
            목록
          </a>
        </div>
      </div>
    </div>
  </article>

  <CTASection />
</BaseLayout>
