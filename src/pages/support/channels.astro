---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubHero from "@/components/SubHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionTabs from "@/components/SectionTabs.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { site } from "@/data/site";
import { supportSubpages } from "@/data/subpages";
---

<BaseLayout title="소통채널" description="비오랩과 BIOLAB Japan 공식 채널을 안내합니다.">
  <SubHero title="소통채널" description="국내 비오랩과 BIOLAB Japan 공식 채널을 함께 안내합니다." compact />
  <SectionTabs items={supportSubpages} label="문의사항 하위 메뉴" />
  <Breadcrumb parent={{ label: "문의사항", href: "/support/" }} current="소통채널" />

  <section class="section-band bg-white">
    <div class="container-page">
      <SectionTitle eyebrow="COMMUNICATION CHANNEL" title="공식 소통채널" description="사업 문의와 해외 사업 확인을 위한 공식 연결 경로입니다." />
      <div class="grid gap-6 md:grid-cols-2" data-reveal-group>
        <article class="border border-slate-200 bg-white p-8 shadow-sm" data-reveal>
          <h2 class="text-2xl font-black text-brand-navy">BIOLAB Korea</h2>
          <p class="mt-4 text-sm leading-7 text-slate-600">국내 제품 문의, OEM/ODM, 입점, 브랜드 협업 문의는 비오랩 대표 이메일로 접수합니다.</p>
          <a class="mt-7 inline-flex bg-brand-green px-5 py-3 text-sm font-bold text-white" href={`mailto:${site.email}`}>{site.email}</a>
        </article>
        <article class="border border-slate-200 bg-white p-8 shadow-sm" data-reveal>
          <h2 class="text-2xl font-black text-brand-navy">BIOLAB Japan</h2>
          <p class="mt-4 text-sm leading-7 text-slate-600">일본 B2B 사업과 브랜드 협업 정보는 BIOLAB Japan 사이트에서 확인할 수 있습니다.</p>
          <a class="mt-7 inline-flex bg-brand-navy px-5 py-3 text-sm font-bold text-white" href={site.japanUrl} target="_blank" rel="noreferrer">BIOLAB Japan 바로가기</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
