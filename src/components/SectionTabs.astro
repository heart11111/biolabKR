---
import type { SubpageItem } from "@/data/subpages";
import { withBase } from "@/lib/path";

type Props = {
  items: SubpageItem[];
  currentHref?: string;
  label: string;
};

const { items, currentHref = Astro.url.pathname, label } = Astro.props;
const basePath = import.meta.env.BASE_URL || "/";
const pathWithoutBase = basePath !== "/" && currentHref.startsWith(basePath)
  ? `/${currentHref.slice(basePath.length)}`
  : currentHref;
const normalizedCurrent = pathWithoutBase.endsWith("/") ? pathWithoutBase : `${pathWithoutBase}/`;
const isActive = (href: string) => normalizedCurrent === href || normalizedCurrent.startsWith(href);
---

<nav class="border-b border-slate-200 bg-white" aria-label={label}>
  <div class="container-page">
    <div class="flex gap-2 overflow-x-auto py-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {items.map((item) => (
        <a
          class:list={[
            "shrink-0 border px-5 py-3 text-sm font-extrabold transition",
            isActive(item.href)
              ? "border-brand-green bg-brand-green text-white shadow-sm"
              : "border-slate-200 bg-white text-slate-700 hover:border-brand-green hover:text-brand-green"
          ]}
          href={withBase(item.href)}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>
